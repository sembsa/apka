<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" data-nosnippet>
    <div class="components-reconnect-container">
        <div class="components-rejoining-animation" aria-hidden="true">
            <div></div>
            <div></div>
        </div>
        <p class="components-reconnect-first-attempt-visible">
            Łączymy się ponownie…
        </p>
        <p class="components-reconnect-repeated-attempt-visible">
            Nie udało się połączyć. Próbujemy znowu za <span id="components-seconds-to-next-attempt"></span> s.
        </p>
        <p class="components-reconnect-failed-visible">
            Nie udało się połączyć. Spróbuj ponownie albo odśwież stronę — nic nie przepadło.
        </p>
        <button id="components-reconnect-button" class="components-reconnect-failed-visible">Spróbuj ponownie</button>
        <p class="components-pause-visible">
            Wstrzymaliśmy sesję po naszej stronie.
        </p>
        <p class="components-resume-failed-visible">
            Nie udało się wrócić do sesji. Spróbuj ponownie albo odśwież stronę.
        </p>
        <button id="components-resume-button" class="components-pause-visible components-resume-failed-visible">Wróć do pracy</button>
    </div>
</dialog>
