@page "/editor/{ProjectId}"
@inject IProjectApi Api
@using Generator.Web.Contracts
@implements IAsyncDisposable

<h1>Twoja strona</h1>

@if (_project is null)
{
    <p>Wczytuję…</p>
}
else
{
    var wersja = _project.Aktualna();

    @if (_project.Status == "frozen")
    {
        <p role="alert" data-test="zamrozone">
            Wykorzystaliście wszystkie poprawki w tym pakiecie. Strona i podgląd zostają —
            nowych poprawek na razie nie wprowadzamy.
        </p>
    }

    <p data-test="licznik">
        Wykorzystane poprawki: @_project.RoundsUsed z @_project.RoundsLimit
    </p>

    @if (wersja is not null)
    {
        @* id jest tu potrzebne: shim przyjmuje klikniecia tylko z TEGO iframe'a. *@
        <iframe id="@_iframeId" title="Podgląd Twojej strony" src="@wersja.PreviewUrl"></iframe>

        @if (wersja.OrphanedAnchors.Count > 0)
        {
            <p role="alert" data-test="osierocone">
                Uwaga: po ostatniej poprawce zniknęły bloki, do których przypisane były
                Twoje uwagi (@string.Join(", ", wersja.OrphanedAnchors)). Sprawdź, czy strona
                nadal zawiera to, co miała.
            </p>
        }
    }

    <CommentBridge OnCommentDrafted="Draft" IframeId="@_iframeId" />

    @if (_draft is not null)
    {
        <div data-test="nowa-uwaga">
            <label for="tresc">
                @(_draft.Anchor is null ? "Uwaga do całej strony" : $"Uwaga do bloku: {_draft.Anchor}")
            </label>
            <textarea id="tresc" rows="3" @bind="_draftText"
                      placeholder="Napisz swoimi słowami, np. telefon za mało widoczny"></textarea>
            <button data-test="dodaj" @onclick="AddDraft">Dodaj uwagę</button>
        </div>
    }

    <CommentList Comments="_comments" OnWithdraw="Withdraw" />

    @* Decyzja Przemka: klient MA widziec, co zrobilismy z jego uwagami. Bez tego raport
       per commentId, ktory silnik uczciwie wystawia (3.3), nie trafialby mu przed oczy —
       uwagi zyja w wersji, a po rundzie klient patrzy juz na nastepna. *@
    @if (_zrobione.Count > 0)
    {
        <section data-test="zrobione">
            <h2>Co zrobiliśmy z Twoimi uwagami</h2>
            <CommentList Comments="_zrobione" />
        </section>
    }

    <button data-test="popraw" disabled="@(_comments.Count == 0 || _project.Status == "frozen" || _job.BlokujeNowaRunde())"
            @onclick="Apply">
        Popraw to
    </button>

    <JobStatus Job="_job" />
}

@code {
    [Parameter] public string ProjectId { get; set; } = string.Empty;

    /// Parametr, bo testy nie moga czekac 2 sekund na tik.
    [Parameter] public TimeSpan PollInterval { get; set; } = TimeSpan.FromSeconds(2);

    private readonly string _iframeId = $"podglad-{Guid.NewGuid():N}";

    private ProjectView? _project;
    private List<CommentDto> _comments = [];
    private List<CommentDto> _zrobione = [];
    private CommentDto? _draft;
    private string _draftText = string.Empty;
    private JobView? _job;
    private CancellationTokenSource? _poll;

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        _project = await Api.GetAsync(ProjectId);
        var aktualna = _project.Aktualna();
        _comments = [.. await Api.GetCommentsAsync(ProjectId, _project.NumerAktualnej())];

        // Raport czytamy z API, nie z pamieci komponentu — inaczej pierwszy F5
        // kasowalby klientowi potwierdzenie tego, o co prosil. Bierzemy go z RODZICA
        // tej wersji, nie z `numer - 1`: po powrocie do v1 arytmetyka dawalaby v0
        // i raport znikalby klientowi z oczu.
        _zrobione = _project.Rodzic(aktualna) is { } rodzic
            ? [.. (await Api.GetCommentsAsync(ProjectId, rodzic.Number))
                .Where(c => c.Status == "applied")]
            : [];
    }

    private void Draft(CommentDto comment)
    {
        _draft = comment;
        _draftText = string.Empty;
    }

    private void AddDraft()
    {
        if (_draft is null || string.IsNullOrWhiteSpace(_draftText)) return;

        // Kolejnosc dodawania ma znaczenie — kontrakt 3.2, przy sprzecznych wygrywa ostatnia.
        _comments.Add(_draft with { Text = _draftText.Trim() });
        _draft = null;
        _draftText = string.Empty;
    }

    /// Kontrakt 3.3: frontend umie wycofac, dopoki open. Statusu nie zmienia.
    private void Withdraw(string commentId) =>
        _comments.RemoveAll(c => c.Id == commentId && c.Status == "open");

    private async Task Apply()
    {
        var wersja = _project!.NumerAktualnej();
        var jobId = await Api.ApplyCommentsAsync(ProjectId, wersja, _comments);
        _job = await Api.GetJobAsync(jobId);

        // Kontrakt 4.4: przy nieudanej rundzie komentarze zostaja open i nic nie przepada.
        if (_job.Status == "succeeded") await Reload();
        else if (_job.WTokuDlaKlienta()) Dopytuj(jobId);
    }

    /// <summary>
    /// Zadanie trwa (albo silnik powtarza), a wynik przyjdzie sam — bez tego klient
    /// zostawal z „pracuje" i zablokowanym przyciskiem do odswiezenia strony.
    /// Pytamy o stan, nie o dane: `Reload` wolamy tylko wtedy, gdy naprawde jest co
    /// przeladowac. Petla ustaje na stanie koncowym i przy zamknieciu komponentu —
    /// inaczej kazdy klient zostawia po sobie timer bijacy w API.
    /// </summary>
    private void Dopytuj(string jobId)
    {
        _poll?.Cancel();
        _poll = new CancellationTokenSource();
        _ = Petla(jobId, _poll.Token);
    }

    private async Task Petla(string jobId, CancellationToken ct)
    {
        using var timer = new PeriodicTimer(PollInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                var job = await Api.GetJobAsync(jobId);

                // Klient mogl zamknac karte w czasie tego zapytania. Renderowanie
                // w zdjety komponent rzuca w watku tla, gdzie nikt tego nie lapie.
                if (ct.IsCancellationRequested) return;
                if (job == _job) continue;      // rekordy: rownosc po wartosci

                _job = job;
                if (job.Status == "succeeded") await Reload();
                await InvokeAsync(StateHasChanged);

                if (!job.WTokuDlaKlienta()) return;   // succeeded albo halted = koniec
            }
        }
        catch (OperationCanceledException)
        {
            // Klient zamknal strone w trakcie rundy. Nie jest to blad.
        }
        catch (ObjectDisposedException)
        {
            // Reszta wyscigu: obwod zdjety dokladnie w trakcie renderu. Tez nie blad.
        }
    }

    public ValueTask DisposeAsync()
    {
        _poll?.Cancel();
        _poll?.Dispose();
        return ValueTask.CompletedTask;
    }
}
