@page "/editor/{ProjectId}"
@inject IProjectApi Api
@inject IJSRuntime JS
@using Generator.Web.Api
@using Generator.Web.Contracts
@implements IAsyncDisposable

<h1>Twoja strona</h1>

@if (_nieZnaleziono)
{
    @* Model „bez kont, token w linku" (decyzja 3) znaczy, ze wejscie na link, ktorego
       nie znamy, jest normalna sytuacja klienta — nie awaria i nie 500 w twarz. *@
    <p role="alert" data-test="nie-znaleziono">
        Nie znaleźliśmy strony pod tym linkiem. Sprawdź, czy jest cały —
        najlepiej otwórz go jeszcze raz z wiadomości, którą od nas dostałeś.
    </p>
}
else if (_project is null)
{
    <p>Wczytuję…</p>
}
else
{
    var wersja = _project.Aktualna();

    @if (_project.Status == "frozen")
    {
        <p role="alert" data-test="zamrozone">
            Wykorzystaliście wszystkie poprawki w tym pakiecie. Strona i podgląd zostają —
            nowych poprawek na razie nie wprowadzamy.
        </p>
    }

    <p data-test="licznik">
        Wykorzystane poprawki: @_project.RoundsUsed z @_project.RoundsLimit
    </p>

    @if (wersja is not null)
    {
        @* Podswietlenie wlaczamy FLAGA — zbior zmienionych blokow zna serwer.
           Kontrakt 5.3. *@
        var zmienioneJest = (wersja.ChangedAnchors?.Count ?? 0) > 0;
        var src = zmienioneJest && _pokazZmiany
            ? $"{wersja.PreviewUrl}?zmienione=true"
            : wersja.PreviewUrl;

        @* Tryb podgladu jest JEDNYM zrodlem prawdy o viewporcie (kontrakt 3.2):
           steruje szerokoscia iframe'a i trafia do uwagi. Zadnego progu w pikselach
           po drugiej stronie, wiec nie ma czemu sie rozjechac. *@
        <div class="podglad-pasek" data-test="tryb-podgladu">
            <button data-test="tryb-desktop" class="@(_viewport == Podglad.Desktop ? "wybrany" : null)"
                    aria-pressed="@Wybrany(Podglad.Desktop)"
                    @onclick='() => Tryb(Podglad.Desktop)'>
                Komputer
            </button>
            <button data-test="tryb-mobile" class="@(_viewport == Podglad.Mobile ? "wybrany" : null)"
                    aria-pressed="@Wybrany(Podglad.Mobile)"
                    @onclick='() => Tryb(Podglad.Mobile)'>
                Telefon
            </button>
        </div>

        @* id jest tu potrzebne: shim przyjmuje klikniecia tylko z TEGO iframe'a. *@
        <div class="podglad podglad-@_viewport">
            <iframe id="@_iframeId" title="Podgląd Twojej strony" src="@src"></iframe>
        </div>

        @if (zmienioneJest)
        {
            <p data-test="zmiany">
                <label>
                    <input type="checkbox" data-test="pokaz-zmiany"
                           checked="@_pokazZmiany"
                           @onchange="e => _pokazZmiany = (bool)e.Value!" />
                    Pokaż, co się zmieniło (@wersja.ChangedAnchors!.Count
                    @(wersja.ChangedAnchors!.Count == 1 ? "miejsce" : "miejsca"))
                </label>
            </p>
        }

        @if (wersja.OrphanedAnchors.Count > 0)
        {
            <p role="alert" data-test="osierocone">
                Uwaga: po ostatniej poprawce zniknęły bloki, do których przypisane były
                Twoje uwagi (@string.Join(", ", wersja.OrphanedAnchors)). Sprawdź, czy strona
                nadal zawiera to, co miała.
            </p>
        }
    }

    <CommentBridge OnCommentDrafted="Draft" IframeId="@_iframeId" Viewport="@_viewport" />

    @if (_draft is not null)
    {
        <div data-test="nowa-uwaga">
            <label for="tresc">
                @(_draft.Anchor is null ? "Uwaga do całej strony" : $"Uwaga do bloku: {_draft.Anchor}")
            </label>
            <textarea id="tresc" rows="3" @bind="_draftText"
                      placeholder="Napisz swoimi słowami, np. telefon za mało widoczny"></textarea>
            <button data-test="dodaj" @onclick="AddDraft">Dodaj uwagę</button>
        </div>
    }

    <CommentList Comments="_comments" OnWithdraw="Withdraw" />

    @* Decyzja Przemka: klient MA widziec, co zrobilismy z jego uwagami. Bez tego raport
       per commentId, ktory silnik uczciwie wystawia (3.3), nie trafialby mu przed oczy —
       uwagi zyja w wersji, a po rundzie klient patrzy juz na nastepna. *@
    @if (_zrobione.Count > 0)
    {
        <section data-test="zrobione">
            <h2>Co zrobiliśmy z Twoimi uwagami</h2>
            <CommentList Comments="_zrobione" />
        </section>
    }

    @* Liczy sie to, co JEST DO WYSLANIA, nie dlugosc listy. Po powrocie do wersji, z
       ktorej juz zglaszano uwagi, na liscie sa same `applied` — przycisk bylby aktywny
       i nie robilby nic. *@
    <button data-test="popraw" disabled="@(DoWyslania().Count == 0 || _project.Status == "frozen" || _job.BlokujeNowaRunde())"
            @onclick="Apply">
        Popraw to
    </button>

    @if (_kolizja is not null)
    {
        <p role="alert" data-test="kolizja">@_kolizja</p>
    }

    <JobStatus Job="_job" />

    <HistoriaWersji Project="_project" Job="_job" OnRollback="Wroc" />
}

@code {
    [Parameter] public string ProjectId { get; set; } = string.Empty;

    /// Parametr, bo testy nie moga czekac 2 sekund na tik.
    [Parameter] public TimeSpan PollInterval { get; set; } = TimeSpan.FromSeconds(2);

    private readonly string _iframeId = $"podglad-{Guid.NewGuid():N}";

    private ProjectView? _project;
    private List<CommentDto> _comments = [];
    private List<CommentDto> _zrobione = [];
    private CommentDto? _draft;
    private string _draftText = string.Empty;
    private JobView? _job;
    private string? _kolizja;

    /// Cztery wyjatki, ktorymi `ProjectApi` mowi „nie teraz" albo „juz nie" — wszystkie
    /// sa normalnymi odpowiedziami na klikniecie, nie awariami aplikacji.
    private static bool Kolizja(Exception ex) => ex
        is ProjectFrozenException or StaleVersionException
        or JobRunningException or KeyNotFoundException;

    /// Kontrakt oddaje galaz, nie gotowe zdania — tresc pisze frontend. Po kazdej
    /// kolizji przeladowujemy stan z serwera, bo kolizja z definicji znaczy, ze to,
    /// co klient widzi, rozjechalo sie z prawda.
    private async Task Odswiez(Exception ex)
    {
        _kolizja = ex switch
        {
            ProjectFrozenException => "Wykorzystaliście już wszystkie poprawki w tym pakiecie.",
            JobRunningException => "Poprzednia poprawka jeszcze się liczy — chwila i będzie gotowa.",
            StaleVersionException => "Strona zmieniła się w międzyczasie. Odświeżyliśmy podgląd.",
            _ => "Tej wersji już nie ma. Odświeżyliśmy listę.",
        };
        await Reload();
    }
    private CancellationTokenSource? _poll;

    /// Domyslnie WLACZONE: po rundzie klient chce wiedziec, co sie zmienilo.
    private bool _pokazZmiany = true;

    private bool _nieZnaleziono;

    /// <summary>
    /// Tryb podgladu. Zasiewany z prawdziwego urzadzenia, nie ustawiony na sztywno:
    /// klient otwierajacy link na telefonie ma dostac telefon, a nie „desktop" tylko
    /// dlatego, ze taka jest wartosc domyslna pola.
    /// </summary>
    private string _viewport = Podglad.Desktop;
    private bool _trybWybranyPrzezKlienta;

    protected override async Task OnInitializedAsync() => await Reload();

    /// <summary>
    /// Zasiew trybu z prawdziwego urzadzenia. Tylko przy pierwszym renderze i tylko gdy
    /// klient sam jeszcze nie wybral — inaczej kazdy render nadpisywalby jego wybor.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _trybWybranyPrzezKlienta) return;

        try
        {
            var szerokosc = await JS.InvokeAsync<int>("hostWidth");
            var tryb = Podglad.TrybDlaOkna(szerokosc);
            if (tryb == _viewport) return;

            _viewport = tryb;
            StateHasChanged();
        }
        catch (JSException)
        {
            // Brak funkcji (np. w tescie komponentu) nie jest powodem, zeby wywalic
            // klientowi strone. Zostaje „desktop".
        }
        catch (JSDisconnectedException)
        {
            // Klient zamknal karte miedzy renderem a odpowiedzia.
        }
    }

    private async Task Reload()
    {
        try
        {
            _project = await Api.GetAsync(ProjectId);
        }
        catch (KeyNotFoundException)
        {
            // Atrapa trzyma stan w pamieci, wiec zna ten wyjatek po restarcie; klient
            // HTTP z Planu B przyniesie tu 404. Jedno i drugie znaczy „nie ma takiego
            // projektu", a nie „cos sie zepsulo".
            _nieZnaleziono = true;
            _project = null;
            return;
        }

        var aktualna = _project.Aktualna();
        _comments = [.. await Api.GetCommentsAsync(ProjectId, _project.NumerAktualnej())];

        // Raport czytamy z API, nie z pamieci komponentu — inaczej pierwszy F5
        // kasowalby klientowi potwierdzenie tego, o co prosil. Bierzemy go z RODZICA
        // tej wersji, nie z `numer - 1`: po powrocie do v1 arytmetyka dawalaby v0
        // i raport znikalby klientowi z oczu.
        _zrobione = _project.Rodzic(aktualna) is { } rodzic
            ? [.. (await Api.GetCommentsAsync(ProjectId, rodzic.Number))
                .Where(c => c.Status == "applied")]
            : [];
    }

    /// Blazor renderuje bool jako obecnosc atrybutu, a `aria-pressed` bez wartosci nie
    /// mowi czytnikowi ekranu nic. Stad jawny string.
    private string Wybrany(string tryb) => (_viewport == tryb).ToString().ToLowerInvariant();

    /// <summary>
    /// Uwagi, ktore runda naprawde wysle: TYLKO `open`. Po powrocie do wersji, z ktorej
    /// juz raz zglaszano uwagi, na liscie sa rowniez te ZASTOSOWANE — wyslane ponownie
    /// kazalyby modelowi poprawiac to, co jest juz zrobione, i klient placilby runde za
    /// prace wykonana. Jedno miejsce, bo z tego samego musi wynikac stan przycisku:
    /// gdy warunek liczyl dlugosc calej listy, przycisk zapraszal i nie robil nic.
    /// </summary>
    private List<CommentDto> DoWyslania() => [.. _comments.Where(c => c.Status == "open")];

    /// Wybor klienta jest ostateczny — zasiew z urzadzenia go nie nadpisze.
    private void Tryb(string tryb)
    {
        _viewport = tryb;
        _trybWybranyPrzezKlienta = true;
    }

    private void Draft(CommentDto comment)
    {
        _draft = comment;
        _draftText = string.Empty;
    }

    private void AddDraft()
    {
        if (_draft is null || string.IsNullOrWhiteSpace(_draftText)) return;

        // Kolejnosc dodawania ma znaczenie — kontrakt 3.2, przy sprzecznych wygrywa ostatnia.
        _comments.Add(_draft with { Text = _draftText.Trim() });
        _draft = null;
        _draftText = string.Empty;
    }

    /// <summary>
    /// Kontrakt 5.1. Po powrocie do starszej wersji uwagi zebrane do tej pory przestaja
    /// dotyczyc tego, co klient widzi — sa zakotwiczone w wersji, ktorej juz nie oglada.
    /// `Reload` czyta uwagi wersji docelowej, wiec robi to za nas; szkic czyscimy jawnie,
    /// bo wskazuje na blok z porzuconego podgladu.
    /// </summary>
    private async Task Wroc(int wersja)
    {
        try
        {
            await Api.RollbackAsync(ProjectId, wersja);
        }
        catch (Exception ex) when (Kolizja(ex))
        {
            await Odswiez(ex);
            return;
        }

        _draft = null;
        _draftText = string.Empty;
        _kolizja = null;
        await Reload();
    }

    /// Kontrakt 3.3: frontend umie wycofac, dopoki open. Statusu nie zmienia.
    private void Withdraw(string commentId) =>
        _comments.RemoveAll(c => c.Id == commentId && c.Status == "open");

    private async Task Apply()
    {
        var wersja = _project!.NumerAktualnej();

        var doWyslania = DoWyslania();
        if (doWyslania.Count == 0) return;

        string jobId;
        try
        {
            jobId = await Api.ApplyCommentsAsync(ProjectId, wersja, doWyslania);
        }
        catch (Exception ex) when (Kolizja(ex))
        {
            // Atrapa nie rzucala zadnego z tych wyjatkow, wiec az do podmiany backendu
            // ten `catch` nie mial czego lapac. Prawdziwe API rzuca je normalnie —
            // a wyjatek z uchwytu zdarzenia Blazora KONCZY OBWOD: klient dostaje pasek
            // „polaczenie zerwane" zamiast zdania o tym, co sie stalo. Zamrozenie
            // po pietnastej rundzie trafi w kazdego klienta, wiec to nie jest
            // przypadek brzegowy.
            await Odswiez(ex);
            return;
        }

        _kolizja = null;
        _job = await Api.GetJobAsync(jobId);

        // Kontrakt 4.4: przy nieudanej rundzie komentarze zostaja open i nic nie przepada.
        if (_job.Status == "succeeded") await Reload();
        else if (_job.WTokuDlaKlienta()) Dopytuj(jobId);
    }

    /// <summary>
    /// Zadanie trwa (albo silnik powtarza), a wynik przyjdzie sam — bez tego klient
    /// zostawal z „pracuje" i zablokowanym przyciskiem do odswiezenia strony.
    /// Pytamy o stan, nie o dane: `Reload` wolamy tylko wtedy, gdy naprawde jest co
    /// przeladowac. Petla ustaje na stanie koncowym i przy zamknieciu komponentu —
    /// inaczej kazdy klient zostawia po sobie timer bijacy w API.
    /// </summary>
    private void Dopytuj(string jobId)
    {
        _poll?.Cancel();
        _poll = new CancellationTokenSource();
        _ = Petla(jobId, _poll.Token);
    }

    private async Task Petla(string jobId, CancellationToken ct)
    {
        using var timer = new PeriodicTimer(PollInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                var job = await Api.GetJobAsync(jobId);

                // Klient mogl zamknac karte w czasie tego zapytania. Renderowanie
                // w zdjety komponent rzuca w watku tla, gdzie nikt tego nie lapie.
                if (ct.IsCancellationRequested) return;
                if (job == _job) continue;      // rekordy: rownosc po wartosci

                _job = job;
                if (job.Status == "succeeded") await Reload();
                await InvokeAsync(StateHasChanged);

                if (!job.WTokuDlaKlienta()) return;   // succeeded albo halted = koniec
            }
        }
        catch (OperationCanceledException)
        {
            // Klient zamknal strone w trakcie rundy. Nie jest to blad.
        }
        catch (ObjectDisposedException)
        {
            // Reszta wyscigu: obwod zdjety dokladnie w trakcie renderu. Tez nie blad.
        }
    }

    public ValueTask DisposeAsync()
    {
        _poll?.Cancel();
        _poll?.Dispose();
        return ValueTask.CompletedTask;
    }
}
