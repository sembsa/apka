@page "/"
@inject IProjectApi Api
@inject NavigationManager Nav
@using Generator.Engine.Sources
@using Generator.Web.Contracts

<h1>Zrobimy Ci stronę</h1>
<p>Odpowiedz jednym akapitem. Resztą zajmiemy się my.</p>

<div role="group" class="wybor-zrodla">
    <button data-test="tryb-opis" class="@(_mode == Mode.Idea ? "wybrany" : "")"
            @onclick="() => _mode = Mode.Idea">Nie mam strony</button>
    <button data-test="tryb-url" class="@(_mode == Mode.Url ? "wybrany" : "")"
            @onclick="() => _mode = Mode.Url">Mam stronę, ale słabą</button>
</div>

<form @onsubmit="Send" @onsubmit:preventDefault>
    @if (_mode == Mode.Idea)
    {
        <label for="opis">Opowiedz, czym się zajmujesz i dla kogo</label>
        <textarea id="opis" rows="5" @bind="_text"
                  placeholder="Np. Strzygę damsko-męsko w Nowym Sączu, ul. Krakowska 5, tel. 600 100 200, pon-pt 9-18."></textarea>
    }
    else
    {
        <label for="url">Adres Twojej obecnej strony</label>
        @* `text`, nie `url`: przegladarka odrzucilaby „mojafirma.pl" WLASNYM komunikatem,
           zanim formularz dojdzie do nas — a nietechniczny klient wpisuje sama nazwe
           rownie czesto jak pelny adres i `https://` doklejamy mu sami. `inputmode`
           zostaje, bo na telefonie decyduje o klawiaturze. *@
        <input id="url" type="text" inputmode="url" @bind="_text" placeholder="mojafirma.pl" />
    }

    @if (_error is not null)
    {
        <p role="alert">@_error</p>
    }

    <button type="submit" disabled="@_busy">@(_busy ? "Tworzę…" : "Dalej")</button>
</form>

@code {
    private enum Mode { Idea, Url }

    private Mode _mode = Mode.Idea;
    private string _text = string.Empty;
    private string? _error;
    private bool _busy;

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(_text))
        {
            _error = _mode == Mode.Idea
                ? "Napisz kilka słów o tym, czym się zajmujesz."
                : "Napisz adres swojej strony.";
            return;
        }

        _error = null;
        _busy = true;

        // W trybie „mam strone" zalozenie projektu POBIERA te strone, wiec moze sie nie
        // udac z powodu, ktory jest po stronie klienta: literowka w adresie, strona
        // wylaczona, link do PDF-a. To jedyny moment, w ktorym klient moze to naprawic
        // sam — pozniej ta sama porazka wracalaby jako „zadanie nieudane", czego on nie
        // odrozni od naszej awarii.
        try
        {
            var project = await Api.CreateAsync(_mode == Mode.Idea ? "idea" : "url", _text.Trim());
            Nav.NavigateTo($"/proposals/{project.Id}");
        }
        catch (ZrodloException)
        {
            // Powod z wyjatku NIE idzie na ekran: mowi o naszej infrastrukturze
            // („adres wskazuje na siec niedostepna"), a klientowi nie pomaga. Do logu
            // trafia przez warstwe HTTP; tutaj liczy sie, co ma zrobic dalej.
            _error = "Nie udało się otworzyć strony spod tego adresu. " +
                     "Sprawdź, czy jest poprawny — albo opisz swoją firmę słowami.";
            _busy = false;
        }
    }
}
