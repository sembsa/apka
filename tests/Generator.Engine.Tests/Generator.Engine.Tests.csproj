<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Generator.Engine\Generator.Engine.csproj" />
  </ItemGroup>

  <!-- Punkt 11 raportu: bez tego "dotnet test <sciezka-do-csproj>" na swiezym
       klonie pada z NETSDK1004 (brak project.assets.json dla Generator.FakeClaude) —
       przez solucje dziala, bo `dotnet test`/`build` na .sln przywraca WSZYSTKIE
       projekty w niej wymienione, ale wywolanie samego tego .csproj (typowe w IDE
       i w niejednym kroku CI) nigdy nie wyzwala restore dla projektu, o ktorym
       ten plik nie wie NIC poza wlasnym celem MSBuild ponizej. ReferenceOutputAssembly
       ="false": to nadal NIE jest prawdziwa referencja binarna (patrz komentarz pod
       celem BuildFakeClaude) — chodzi wylacznie o to, zeby restore/build tego
       projektu byl uwzgledniony w grafie zaleznosci, bez linkowania jego wyjscia. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Generator.FakeClaude\Generator.FakeClaude.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Atrapa NIE jest (w sensie linkowania) ProjectReference: to program konsolowy,
       nie biblioteka. Budujemy ja do siostrzanego OutDir i odpalamy przez `dotnet <dll>`.
       OutDir musi byc jawnie zlozony z $(MSBuildProjectDirectory) tego projektu:
       $(OutDir) jest wzgledny (np. "bin\Debug\net10.0\"), a MSBuild rozwiazuje
       wzgledne Properties przekazane do zagniezdzonego <MSBuild> wzgledem
       katalogu WYWOLYWANEGO projektu (Generator.FakeClaude), nie wywolujacego —
       bez tego atrapa buduje sie do wlasnego bin/, a testy odpalaja stara kopie
       zostawiona przez wczesniejszy build (cichy punkt awarii, sprawdzone empirycznie
       w Tasku 4 fix round 1: FakeClaudeTests i ClaudeRunnerTests padaja na czystym
       repo, bo katalog $(OutDir)FakeClaude w tests/ nigdy nie powstaje). -->
  <Target Name="BuildFakeClaude" AfterTargets="Build">
    <MSBuild Projects="..\..\src\Generator.FakeClaude\Generator.FakeClaude.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);OutDir=$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(OutDir)', 'FakeClaude'))" />
  </Target>

</Project>
